{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DJ Assistant",
  "version": "0.1.0",
  "identifier": "com.deejaykyle.djassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DJ Assistant",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DeeJayKyle",
    "copyright": "Copyright (c) 2026 DeeJayKyle. MIT licence.",
    "category": "Music",
    "shortDescription": "Local-first, read-only DJ library assistant",
    "longDescription": "DJ Assistant catalogues your music folders without changing them: search, smart crates, low-bitrate warnings and conservative duplicate review. Works offline.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}

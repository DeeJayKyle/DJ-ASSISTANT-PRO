{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DJ Assistant",
  "version": "1.7.0",
  "identifier": "com.deejaykyle.djassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DJ Assistant",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": true,
        "backgroundColor": "#0c0f12",
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' track: http://track.localhost; connect-src ipc: http://ipc.localhost track: http://track.localhost",
      "freezePrototype": true
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "DeeJayKyle",
    "copyright": "Copyright (c) 2026 DeeJayKyle. MIT licence.",
    "category": "Music",
    "shortDescription": "Local-first, read-only DJ library assistant",
    "longDescription": "DJ Assistant organises and searches your music folders without changing them: crates and smart crates, audio analysis, suggestions, discovery, Set Studio, gig mode and gig packs. Works offline; online services are optional.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3Qjc4RDg3ODk1Q0REMjMKUldRajNWeUpoNDIzSnlBNW5HZHRqa05jUlN5QWU3R2ZlUFY0MEFYYlg4OTA1bzl0Y2Z4MGFVOTAK",
      "endpoints": [
        "https://github.com/DeeJayKyle/DJ-ASSISTANT-PRO/releases/latest/download/latest.json",
        "https://github.com/DeeJayKyle/dj-assistant-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

{
  "name": "dj-assistant",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:bridge": "VITE_DEV_BRIDGE=1 vite",
    "build": "tsc -b && vite build",
    "build:bridge": "tsc -b && VITE_DEV_BRIDGE=1 vite build --outDir dist-bridge",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/icons/app-icon.png -o src-tauri/icons"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
